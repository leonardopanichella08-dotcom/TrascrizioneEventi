# Porta su cui il server HTTP/Socket.io resta in ascolto.
# Le piattaforme cloud (Render/Railway) iniettano PORT automaticamente: in quel caso questa viene ignorata.
PORT=3001

# Origini consentite per CORS, separate da virgola.
# In sviluppo locale puoi lasciare "*" (wildcard). In produzione imposta il dominio del frontend.
CORS_ORIGIN=*

# Secondi di grazia entro cui lo Speaker puo' riagganciarsi dopo una disconnessione
# senza che la stanza venga distrutta.
SPEAKER_GRACE_PERIOD_SECONDS=60

# Durata massima di vita di una stanza inattiva (ore) prima della pulizia forzata,
# usata come rete di sicurezza contro memory leak in caso di client "zombie".
ROOM_MAX_IDLE_HOURS=6
